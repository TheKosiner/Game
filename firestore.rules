rules_version = '2';
// Last deployed: 2026-06-02 v8 — v9: guild join/leave/kick fixes, UTC daily reset,
// chat/mail sender checks, server-only casino feed. Tests: npm run test:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'thekosiner@gmail.com';
    }

    // ── Save validation ───────────────────────────────────────────────────────
    //
    // Optional fields: very old saves, and every save of a hero who has not had a
    // server daily claim yet (no `streakDays`), lack some keys. Reading a missing
    // key is an *error* in rules, and an error denies the whole write. That used to
    // reject every cloud save of a brand-new player on their first day — the client
    // then reloaded the cloud copy and their progress kept vanishing. So optional
    // fields are read through get() with a default.
    //
    // Cost: a request may evaluate at most 1000 expressions, and a write over the
    // limit is denied. Shared values are therefore computed once in
    // validSaveUpdate and passed down; tests/rules measure the heaviest paths.

    // Day number in UTC — the same calendar the claimDailyReward Cloud Function uses.
    function utcDay(ms) {
      return math.floor(ms / 86400000);
    }

    // A quest may be cleared once its (server-time) timer has run out, or early
    // only when it is abandoned — no reward in the same write. The client's
    // "cancel quest" button used to be rejected, and the quest came back.
    function validQuestClear(oldQ, newQ, oh, nh, now) {
      return oldQ == null
        || newQ != null
        || now >= oldQ.get('endsAt', 0)
        || oldQ.get('endsAt', 0) > now + 3600000
        || (nh.level == oh.level
            && nh.get('xp', 0) <= oh.get('xp', 0)
            && nh.get('goldEarnedToday', 0) <= oh.get('goldEarnedToday', 0)
            && nh.get('questsCompletedToday', 0) == oh.get('questsCompletedToday', 0));
    }

    function validBeggingClear(oh, nh, now) {
      let oldUntil = oh.get('beggingUntil', null);
      return oldUntil == null
        || nh.get('beggingUntil', null) != null
        || nh.get('beggingReward', null) == null
        || now >= oldUntil
        || oldUntil > now + 172800000;
    }

    // A client-side reset (fallback when the Cloud Function is unreachable) is
    // accepted once the UTC day has rolled over, matching the server. The older
    // 23h gate stays as an alternative so clients still on the previous build,
    // which reset on their own calendar, keep working.
    function validDailyReset(oldReset, newReset, now) {
      return newReset == oldReset
        || oldReset > now
        || (newReset >= now - 300000
            && newReset <= now + 10000
            && (now - oldReset >= 82800000 || utcDay(now) > utcDay(oldReset)));
    }

    function validRestClear(oh, nh, now) {
      let oldUntil = oh.get('voluntaryRestUntil', null);
      return oldUntil == null
        || nh.get('voluntaryRestUntil', null) != null
        || (nh.get('voluntaryRestHp', null) == null
            && nh.get('voluntaryRestStartAt', null) == null
            && now < oldUntil)
        || now >= oldUntil
        || oldUntil > now + 172800000;
    }

    function validChallengeCooldown(old, nw, now) {
      let oldAt = old.get('lastChallengeAt', 0);
      return nw.get('lastChallengeAt', 0) <= oldAt
        || oldAt == 0
        || oldAt > now
        || now - oldAt >= 3600000;
    }

    // Gold earned today, against the daily cap. After a daily reset the baseline
    // is 0, not yesterday's total. Completed tasks started before the reset may be
    // collected in the reset write itself without counting toward the cap.
    function validGoldEarned(oh, nh, oldQ, newQ, now, reset, newReset) {
      let oldEarned = oh.get('goldEarnedToday', 0);
      let newEarned = nh.get('goldEarnedToday', 0);
      let begReward = oh.get('beggingReward', null);
      let begStart = oh.get('beggingStartAt', null);
      let begUntil = oh.get('beggingUntil', null);
      let beggingPending = (reset && begReward != null
        && nh.get('beggingReward', null) == null
        && begStart != null && begStart < newReset
        && begUntil != null && begUntil <= now)
        ? begReward : 0;
      let questPending = (reset && oldQ != null && newQ == null
        && oldQ.get('startedAt', null) != null && oldQ.startedAt < newReset
        && oldQ.get('endsAt', null) != null && oldQ.endsAt <= now
        && oldQ.get('quest', null) != null)
        ? oldQ.quest.get('goldReward', 0) : 0;
      return
        (reset ? newEarned >= 0 : newEarned >= oldEarned)
        && newEarned <= 250000000
        && nh.gold >= 0
        && nh.gold <= 1000000000
        && nh.gold <= oh.get('gold', 0) + newEarned - (reset ? 0 : oldEarned) + beggingPending + questPending;
    }

    // Gems are premium currency. Client writes may only ADD small amounts that come
    // from level-ups (+3/level, up to the +10 levels a single save may carry = +30)
    // and the local daily-reward fallback (+5). All larger sources (Stripe purchases,
    // the server daily reward) are credited server-side by Cloud Functions before the
    // client save lands. Spending freely decreases. This blocks "set gems to a
    // million" localStorage tampering.
    function validGems(oh, nh) {
      let gems = nh.get('gems', null);
      return gems is number && gems >= 0 && gems <= oh.get('gems', 0) + 40;
    }

    // streakDays is written by the claimDailyReward Cloud Function (admin SDK,
    // bypasses rules). Clients must never increase it — doing so would let a player
    // fake a 19-day streak and claim a legendary chest. Exception: on a daily reset
    // (gated by validDailyReset) it may rise by at most 1 — the checkDailyReset()
    // local fallback when the Cloud Function is unavailable.
    // Daily run counters only go up during a day; the Cloud Function resets them,
    // and a client may only zero them together with a daily reset.
    function validStreakAndCounters(oh, nh, reset) {
      let newStreak = nh.get('streakDays', null);
      return (newStreak == null || newStreak <= oh.get('streakDays', 0) + (reset ? 1 : 0))
        && (reset
            || (nh.get('dungeonRunsToday', 0)     >= oh.get('dungeonRunsToday', 0)
                && nh.get('kryptaRunsToday', 0)      >= oh.get('kryptaRunsToday', 0)
                && nh.get('questsCompletedToday', 0) >= oh.get('questsCompletedToday', 0)));
    }

    function validCounters(old, nw) {
      let oldWins = old.get('pvpWins', 0);
      let oldLosses = old.get('pvpLosses', 0);
      let oldRating = old.get('pvpRating', 1000);
      let oldUnlocked = old.get('challengeUnlocked', 0);
      let wins = nw.get('pvpWins', 0);
      let losses = nw.get('pvpLosses', 0);
      let rating = nw.get('pvpRating', 1000);
      let unlocked = nw.get('challengeUnlocked', 0);
      return wins >= oldWins && wins <= oldWins + 1
        && losses >= oldLosses && losses <= oldLosses + 1
        && rating <= oldRating + 30 && rating >= oldRating - 20
        && unlocked >= oldUnlocked && unlocked <= oldUnlocked + 1;
    }

    // ── Stat delta validation — blocks localStorage inflation ─────────────────
    function validSaveUpdate(old, nw) {
      let oh = old.hero;
      let nh = nw.hero;
      let now = request.time.toMillis();
      let oldReset = oh.get('lastDailyReset', 0);
      let newReset = nh.get('lastDailyReset', 0);
      let reset = newReset != oldReset;
      let oldQ = old.get('activeQuest', null);
      let newQ = nw.get('activeQuest', null);
      let begReward = nh.get('beggingReward', null);
      return
        // Headroom for a legitimate endgame run. A maxed-out operation on the
        // hardest difficulty in XP mode is worth just over 4 levels, so the
        // previous +5 left no margin and rejected honest saves — which made the
        // client revert the whole run. +10 still blocks jumping to an arbitrary
        // level while leaving real play room to breathe. (Bigger rewards are
        // banked by the client and applied over several saves.)
        nh.level <= oh.level + 10
        && nw.get('updatedAt', null) == request.time
        && (begReward == null || begReward <= 250000000)
        && validCounters(old, nw)
        && validGems(oh, nh)
        && validStreakAndCounters(oh, nh, reset)
        && validDailyReset(oldReset, newReset, now)
        && validGoldEarned(oh, nh, oldQ, newQ, now, reset, newReset)
        && validQuestClear(oldQ, newQ, oh, nh, now)
        && validBeggingClear(oh, nh, now)
        && validRestClear(oh, nh, now)
        && validChallengeCooldown(old, nw, now);
    }

    function validPlayerUpdate(old, nw) {
      // PvP stat constraints live in validSaveUpdate (saves collection).
      // Only guard against large level jumps on the public profile.
      return nw.get('level', 0) <= old.get('level', 0) + 20;
    }

    // The public profile drives the leaderboards, so its level and PvP numbers
    // may not run ahead of the player's own (validated) save, and the name on it
    // must be the player's registered username. Accounts without a save yet
    // (legacy) are let through.
    function playerMatchesSave(uid, nw) {
      let savePath = /databases/$(database)/documents/saves/$(uid);
      return !exists(savePath) || (
        nw.get('level', 0) <= get(savePath).data.hero.level
        && nw.get('pvpRating', 0) <= get(savePath).data.get('pvpRating', 1000)
        && nw.get('pvpWins', 0) <= get(savePath).data.get('pvpWins', 0)
      );
    }

    function nameUnchangedOrOwn(old, nw) {
      return nw.get('username', null) == old.get('username', null)
        || isOwnUsername(nw.get('username', null));
    }

    // User profiles (private). The username is fixed at registration — it must be
    // the one claimed in the usernames registry in the same transaction — because
    // chat, mail and the public profile are checked against it.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == request.auth.uid;
      allow update: if isOwner(userId)
        && request.resource.data.get('username', null) == resource.data.get('username', null);
    }

    // Game saves — delta + time validation on every write
    match /saves/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(userId) && validSaveUpdate(resource.data, request.resource.data));
    }

    // Public leaderboard profiles
    match /players/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && playerMatchesSave(userId, request.resource.data)
        && (request.resource.data.get('username', null) == null
            || isOwnUsername(request.resource.data.get('username', null)));
      allow update: if isAdmin();
      allow update: if isOwner(userId)
        && validPlayerUpdate(resource.data, request.resource.data)
        && playerMatchesSave(userId, request.resource.data)
        && nameUnchangedOrOwn(resource.data, request.resource.data);
      // Only the document owner may update their own guild membership fields
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['guildId', 'guildTag']);
    }

    // Username uniqueness registry
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
    }

    // ── Guilds ────────────────────────────────────────────────────────────────

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function guildRoleOf(guild) {
      return request.auth.uid in guild.members ? guild.members[request.auth.uid].role : null;
    }

    // Keys of the members map that this write adds, removes or edits.
    function changedMembers() {
      return request.resource.data.members.diff(resource.data.members).affectedKeys();
    }

    // Upgrade levels are bounded (0–50), rise at most one level per write, and a
    // level-up must be paid from the treasury (2000 × 2^level, as in the client).
    function validGuildUpgrades() {
      let oldExp  = resource.data.get('expUpgrade', 0);
      let oldGold = resource.data.get('goldUpgrade', 0);
      let newExp  = request.resource.data.get('expUpgrade', 0);
      let newGold = request.resource.data.get('goldUpgrade', 0);
      let spent   = resource.data.get('treasury', 0) - request.resource.data.get('treasury', 0);
      return newExp >= 0 && newExp <= 50 && newExp <= oldExp + 1
        && newGold >= 0 && newGold <= 50 && newGold <= oldGold + 1
        && (newExp <= oldExp || spent >= 2000 * math.pow(2, oldExp))
        && (newGold <= oldGold || spent >= 2000 * math.pow(2, oldGold))
        && !(newExp > oldExp && newGold > oldGold);
    }

    // The treasury only grows through a deposit: the depositor's own contribution
    // rises by exactly the same amount. Nobody can edit someone else's tally.
    function validTreasury() {
      let oldT = resource.data.get('treasury', 0);
      let newT = request.resource.data.get('treasury', 0);
      let oldC = resource.data.get('contributions', {});
      let newC = request.resource.data.get('contributions', {});
      let contribChanged = newC.diff(oldC).affectedKeys();
      return newT >= 0
        && ((newT <= oldT && contribChanged.size() == 0)
            || (newT > oldT
                && contribChanged.hasOnly([request.auth.uid])
                && newC.get(request.auth.uid, 0) - oldC.get(request.auth.uid, 0) == newT - oldT));
    }

    function validGuildEconomy() {
      return validGuildUpgrades() && validTreasury();
    }

    // A pending operation reward can't be inflated, and its claimedBy list only grows
    // (otherwise a member could clear it and claim the same reward again).
    function validGuildOperation() {
      let oldOp = resource.data.get('guildOperation', null);
      let newOp = request.resource.data.get('guildOperation', null);
      let oldReward = oldOp == null ? null : oldOp.get('pendingReward', null);
      let newReward = newOp == null ? null : newOp.get('pendingReward', null);
      return oldReward == null || newReward == null
        || (newReward.gold <= oldReward.gold
            && newReward.xp <= oldReward.xp
            && newReward.get('claimedBy', {}).keys().hasAll(oldReward.get('claimedBy', {}).keys()));
    }

    match /guilds/{guildId} {
      allow read: if isAuthenticated();

      // Creator becomes the only member, as leader, of a guild that starts empty.
      allow create: if isAuthenticated()
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'leader'
        && request.resource.data.get('treasury', 0) == 0
        && request.resource.data.get('expUpgrade', 0) == 0
        && request.resource.data.get('goldUpgrade', 0) == 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.tag is string && request.resource.data.tag.size() <= 4;

      allow update, delete: if isAdmin();

      // Leader: manages members, roles and leadership (the new leader must already
      // be a member), within the economy limits.
      allow update: if isAuthenticated()
        && resource.data.leaderUid == request.auth.uid
        && request.resource.data.leaderUid in request.resource.data.members
        && validGuildEconomy()
        && validGuildOperation();

      // Officers: everything except leadership. They can't touch the leader's own
      // member entry (no kicking or demoting the leader).
      allow update: if isAuthenticated()
        && guildRoleOf(resource.data) == 'officer'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leaderUid'])
        && !changedMembers().hasAny([resource.data.leaderUid])
        && validGuildEconomy()
        && validGuildOperation();

      // Any member: deposit gold into the treasury.
      allow update: if isAuthenticated()
        && guildRoleOf(resource.data) != null
        && onlyChanged(['treasury', 'contributions'])
        && request.resource.data.get('treasury', 0) > resource.data.get('treasury', 0)
        && validTreasury();

      // Any member: fight in / claim from the guild operation.
      allow update: if isAuthenticated()
        && guildRoleOf(resource.data) != null
        && onlyChanged(['guildOperation'])
        && validGuildOperation();

      // Any member except the leader: leave the guild, or refresh the display fields
      // (level, hero name, portrait) of their own entry without changing its role.
      allow update: if isAuthenticated()
        && guildRoleOf(resource.data) != null
        && request.auth.uid != resource.data.leaderUid
        && onlyChanged(['members'])
        && changedMembers().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.members)
            || (request.resource.data.members[request.auth.uid].role == resource.data.members[request.auth.uid].role
                && request.resource.data.members[request.auth.uid].get('joinedAt', 0) == resource.data.members[request.auth.uid].get('joinedAt', 0)));

      // Joining: only with an invite addressed to the caller, and only by adding
      // their own entry as a plain member.
      allow update: if isAuthenticated()
        && !(request.auth.uid in resource.data.members)
        && onlyChanged(['members'])
        && changedMembers().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'member'
        && exists(/databases/$(database)/documents/guildInvites/$(guildId + '_' + request.auth.uid));

      allow delete: if isAuthenticated()
        && resource.data.leaderUid == request.auth.uid;
    }

    function isGuildManager(guildId) {
      let guild = get(/databases/$(database)/documents/guilds/$(guildId)).data;
      return request.auth.uid in guild.members
        && guild.members[request.auth.uid].role in ['leader', 'officer'];
    }

    // Guild invites. The document id is `<guildId>_<toUid>`, which lets the join
    // rule above check that the invite exists.
    match /guildInvites/{inviteId} {
      // `resource == null` lets a client check whether an invite id is free.
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromUid
      );
      // Only a leader or officer of the guild can invite, under the fixed id.
      allow create: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && inviteId == request.resource.data.guildId + '_' + request.resource.data.toUid
        && isGuildManager(request.resource.data.guildId);
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromUid
      );
    }

    // PvP fight history
    match /pvpHistory/{fightId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.attackerUid == request.auth.uid;
    }

    // Guild Wars — all writes via Cloud Functions (admin SDK); clients read-only
    match /guildWars/{warId} {
      allow read: if isAuthenticated();
    }

    // The sender's display name must be their own registered username, so nobody
    // can post or mail under someone else's name. Accounts older than the
    // username registry have no users doc and are let through.
    function isOwnUsername(name) {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(profile) || get(profile).data.username == name;
    }

    // Chat messages: own uid, own name, 1–200 chars, and no timestamp from the
    // future (newest-first feeds would otherwise pin such a message on top).
    function validChatMessage() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt <= request.time.toMillis() + 300000
        && isOwnUsername(request.resource.data.username);
    }

    // In-game mail
    match /mail/{mailId} {
      allow read, delete: if isAuthenticated()
        && resource.data.toUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && isOwnUsername(request.resource.data.fromUsername);
      allow delete: if isAdmin();
    }

    // Stripe gem credits — written only by Cloud Functions (admin SDK bypasses rules)
    match /gemCredits/{creditId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Lobby presence (one doc per player, owner-only write). The name is checked
    // when it is set; position updates with the same name cost no extra read.
    match /lobbyPlayers/{userId} {
      allow read: if isAuthenticated();
      allow delete: if isOwner(userId);
      allow create: if isOwner(userId) && isOwnUsername(request.resource.data.get('username', null));
      allow update: if isOwner(userId) && nameUnchangedOrOwn(resource.data, request.resource.data);
    }

    // Lobby chat
    match /lobbyChat/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && validChatMessage();
      allow delete: if isAdmin();
    }

    // Global chat
    match /globalChat/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && validChatMessage();
      allow delete: if isAdmin();
    }

    // Casino spin history (global feed). Written only by the spinRoulette Cloud
    // Function, so the feed shows real spins rather than whatever a client posts.
    match /casinoSpins/{spinId} {
      allow read: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Guild chat
    match /guilds/{guildId}/messages/{msgId} {
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.members;
      allow create: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.members
        && validChatMessage();
      allow delete: if isAdmin();
    }

    // Client-side error logs — any authenticated user can write, only admin can read/delete
    match /clientErrors/{errorId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500;
      allow read, delete: if isAdmin();
    }

    // Guild boss
    match /guilds/{guildId}/boss/{doc} {
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.members;
      allow write: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.members;
    }

  }
}
